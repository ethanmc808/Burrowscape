  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BunnyTraitCatalog
  traits:
  - id: energetic
    displayName: Energetic
    description: Energy decays 0.75x as slowly as normal.
    incompatibleTraitIds:
    - lazy
    - sluggish
    effectType: 1
    effectMultiplier: 0.75
  - id: lazy
    displayName: Lazy
    description: Energy decays 1.25x faster than normal.
    incompatibleTraitIds:
    - energetic
    - adventurous
    - hard_worker
    effectType: 1
    effectMultiplier: 1.25
  - id: hard_worker
    displayName: Hard Worker
    description: Produces 1.25x more than normal.
    incompatibleTraitIds:
    - slacker
    - lazy
    effectType: 6
    effectMultiplier: 1.25
  - id: slacker
    displayName: Slacker
    description: Produces 0.75x as much as normal.
    incompatibleTraitIds:
    - diligent
    effectType: 6
    effectMultiplier: 0.75
  - id: cheerful
    displayName: Cheerful
    description: Mood decays 0.75x as slowly as normal.
    incompatibleTraitIds:
    - grumpy
    effectType: 2
    effectMultiplier: 0.75
  - id: grumpy
    displayName: Grumpy
    description: Mood decays 1.25x faster than normal.
    incompatibleTraitIds:
    - cheerful
    effectType: 2
    effectMultiplier: 1.25
  - id: glutton
    displayName: Glutton
    description: Hunger decays 1.25x faster than normal.
    incompatibleTraitIds:
    - light_eater
    effectType: 3
    effectMultiplier: 1.25
  - id: light_eater
    displayName: Light Eater
    description: Hunger decays 0.75x as slowly as normal.
    incompatibleTraitIds:
    - glutton
    effectType: 3
    effectMultiplier: 0.75
  - id: parched
    displayName: Parched
    description: Thirst decays 1.25x faster than normal.
    incompatibleTraitIds:
    - quenched
    effectType: 4
    effectMultiplier: 1.25
  - id: quenched
    displayName: Quenched
    description: Thirst decays 0.75x as slowly as normal.
    incompatibleTraitIds:
    - parched
    effectType: 4
    effectMultiplier: 0.75
  - id: quick_footed
    displayName: Quick-Footed
    description: Moves 1.25x faster than normal.
    incompatibleTraitIds:
    - sluggish
    - lazy
    effectType: 5
    effectMultiplier: 1.1
  - id: sluggish
    displayName: Sluggish
    description: Moves 0.75x as fast as normal.
    incompatibleTraitIds:
    - quick_footed
    - energetic
    effectType: 5
    effectMultiplier: 0.9
  - id: stoic
    displayName: Stoic
    description: Ignores this bunny's Zodiac (Nature) stat modifier entirely.
    incompatibleTraitIds:
    - cheerful
    - grumpy
    effectType: 7
    effectMultiplier: 1
  - id: adventurous
    displayName: Adventurous
    description: Energy decays 0.75x as slowly as normal while Foraging.
    incompatibleTraitIds:
    - homebody
    - lazy
    effectType: 1
    effectMultiplier: 0.75
  - id: homebody
    displayName: Homebody
    description: Energy decays 1.25x faster than normal while Foraging.
    incompatibleTraitIds:
    - adventurous
    effectType: 1
    effectMultiplier: 1.25
  - id: treasurehunter
    displayName: Treasure Hunter
    description: Increased chance of finding Rare Loot while Foraging.
    incompatibleTraitIds:
    - adventurous
    effectType: 8
    effectMultiplier: 2
  - id: smart
    displayName: Smart
    description: Gains 1.25x XP from all sources.
    incompatibleTraitIds:
    - dumb
    effectType: 9
    effectMultiplier: 1.25
  - id: dumb
    displayName: Dumb
    description: Gains 0.75x XP from all sources.
    incompatibleTraitIds:
    - smart
    effectType: 9
    effectMultiplier: 0.75
